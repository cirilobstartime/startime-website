{
  "name": "startime-corporate-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:types && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "payload:generate:types": "payload generate:types",
    "payload:generate:importmap": "payload generate:importmap",
    "create-admin": "tsx scripts/create-admin.ts",
    "backup:recovery": "bash scripts/create-recovery-archive.sh",
    "check:secrets": "node scripts/check-repository-secrets.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/nodemailer": "^8.0.1",
    "graphql": "^16.11.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "motion": "12.23.12",
    "next": "16.2.11",
    "nodemailer": "^9.0.4",
    "payload": "3.86.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.2",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.10",
    "prettier": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "framer-motion": "12.23.12",
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6",
    "sharp": "$sharp"
  }
