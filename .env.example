PAYLOAD_SECRET=replace-with-a-long-random-secret
FORM_SECURITY_SECRET=replace-with-an-independent-long-random-secret
# Use the exact same 32+ character value on startime.sa and sim.startime.sa.
ATTRIBUTION_SECURITY_SECRET=replace-with-a-shared-cross-domain-secret
DATABASE_URL=file:./startime.db
NEXT_PUBLIC_APP_URL=https://startime.sa
# Internal form notifications (use an app password, never an account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@startime.sa
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM=Startime Website <website@startime.sa>
